{
  "name": "credit-queue",
  "version": "0.1.0",
  "description": "Atomic Redis Lua credit gate and write-behind event queue with two-phase reservations (reserve, settle, release) and monotonic versioning.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/spyglass-so/credit-queue.git"
  },
  "homepage": "https://github.com/spyglass-so/credit-queue#readme",
  "bugs": {
    "url": "https://github.com/spyglass-so/credit-queue/issues"
  },
  "keywords": [
    "redis",
    "upstash",
    "billing",
    "credits",
    "queue",
    "metering",
    "rate-limit",
    "lua"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
